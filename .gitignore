# prototype: raw fetches, observation dumps and vendored deps are reproducible, keep them local
prototype/raw/
prototype/out/obs.*.jsonl
prototype/.pylib/
__pycache__/
*.pyc
/target

# private rosters (the author's gateway rosters, unlicensed third-party data): kept on the author's
